<%- include('partials/header') %>

<main class="project-details-page">

    <section class="project-details-card">

        <h1><%= project.title %></h1>

        <p class="project-description">
            <%= project.description %>
        </p>

        <p class="project-date">
            <strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString() %>
        </p>

        <p class="project-location">
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p class="project-organization">
            <strong>Partner Organization:</strong>

            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

    </section>

    <div class="project-categories">

    <strong>Categories:</strong>

    <% categories.forEach(category => { %>

        <a
            href="/category/<%= category.category_id %>"
            class="category-tag"
        >
            <%= category.name %>
        </a>

    <% }) %>

    </div>

    <% if (user && user.role_name === 'admin') { %>

    <p>
        <a href="/assign-categories/<%= project.project_id %>">
            Edit Categories
        </a>
    </p>

    <p>
        <a href="/edit-project/<%= project.project_id %>">
            Edit Project
        </a>
    </p>

<% } %>

<% if (user) { %>

    <% if (volunteering) { %>

        <p>
            <strong>
                You are volunteering for this project.
            </strong>
        </p>

        <p>
            <a href="/project/<%= project.project_id %>/unvolunteer">
                Remove Volunteer Signup
            </a>
        </p>

    <% } else { %>

        <p>
            <a href="/project/<%= project.project_id %>/volunteer">
                Volunteer For This Project
            </a>
        </p>

    <% } %>

<% } %>

</main>

<%- include('partials/footer') %>