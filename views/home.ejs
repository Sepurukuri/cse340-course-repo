<%- include('partials/header') %>

<main class="home-page">

    <section class="hero-section">

        <div class="hero-content">

            <h1>Welcome to Community Service Hub</h1>

            <p>
                Discover volunteer opportunities, nonprofit organizations,
                and meaningful service projects that help strengthen
                communities and improve lives.
            </p>

        </div>

    </section>

    <section class="home-image-section">

        <img
            src="/images/community-service.png"
            alt="Community volunteers working together"
            class="home-hero-image"
        >

    </section>

    <% if (isLoggedIn) { %>
        <section class="dashboard-link-section">

            <p>
                <a href="/dashboard">
                    My Dashboard
                </a>
            </p>

        </section>
    <% } %>

</main>

<%- include('partials/footer') %>
