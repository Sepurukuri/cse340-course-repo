<%- include('partials/header') %>

<main class="organizations-page">

    <h1>Our Partner Organizations</h1>

    <p>
        We proudly collaborate with organizations dedicated to improving
        communities through sustainability, education, volunteer service,
        and humanitarian outreach.
    </p>

    <section class="organizations-list">

        <!-- Organization 1 -->
        <article class="organization-card">

            <img
                src="/images/brightfuture-logo.png"
                alt="BrightFuture Builders logo"
                class="organization-logo"
                width="150"
            >

            <div class="organization-info">

                <h2>BrightFuture Builders</h2>

                <p class="organization-description">
                    BrightFuture Builders is a nonprofit organization focused on
                    improving local communities through sustainable construction
                    projects, affordable housing initiatives, and volunteer-led
                    infrastructure development.
                </p>

                <p class="organization-email">
                    <strong>Contact Email:</strong>
                    info@brightfuturebuilders.org
                </p>

            </div>

        </article>

        <!-- Organization 2 -->
        <article class="organization-card">

            <img
                src="/images/greenharvest-logo.png"
                alt="GreenHarvest Growers logo"
                class="organization-logo"
                width="150"
            >

            <div class="organization-info">

                <h2>GreenHarvest Growers</h2>

                <p class="organization-description">
                    GreenHarvest Growers is an urban farming collective that
                    promotes sustainable agriculture, environmental awareness,
                    and food education programs for families and schools in
                    underserved neighborhoods.
                </p>

                <p class="organization-email">
                    <strong>Contact Email:</strong>
                    contact@greenharvest.org
                </p>

            </div>

        </article>

        <!-- Organization 3 -->
        <article class="organization-card">

            <img
                src="/images/unityserve-logo.png"
                alt="UnityServe Volunteers logo"
                class="organization-logo"
                width="150"
            >

            <div class="organization-info">

                <h2>UnityServe Volunteers</h2>

                <p class="organization-description">
                    UnityServe Volunteers coordinates community service projects,
                    charity events, and volunteer opportunities that support
                    local shelters, educational initiatives, and humanitarian
                    outreach programs.
                </p>

                <p class="organization-email">
                    <strong>Contact Email:</strong>
                    hello@unityserve.org
                </p>

            </div>

        </article>

        <!-- Organization 4 -->
        <article class="organization-card">

            <img
                src="/images/oceanhope-logo.png"
                alt="OceanHope Foundation logo"
                class="organization-logo"
                width="150"
            >

            <div class="organization-info">

                <h2>OceanHope Foundation</h2>

                <p class="organization-description">
                    OceanHope Foundation works to protect marine ecosystems
                    through beach cleanups, ocean conservation education,
                    and environmental research partnerships with local schools
                    and universities.
                </p>

                <p class="organization-email">
                    <strong>Contact Email:</strong>
                    support@oceanhope.org
                </p>

            </div>

        </article>

    </section>

</main>

<%- include('partials/footer') %>