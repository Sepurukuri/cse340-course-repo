<%- include('partials/header') %>

<main class="organizations-page">

    <h1><%= title %></h1>

    <p>
        We proudly collaborate with organizations dedicated to improving
        communities through sustainability, education, volunteer service,
        and humanitarian outreach.
    </p>

    <section class="organizations-list">

        <% organizations.forEach(organization => { %>

            <article class="organization-card">

                <img
                    src="/images/<%= organization.logo_filename %>"
                    alt="<%= organization.name %> logo"
                    class="organization-logo"
                    width="150"
                >

                <div class="organization-info">

                    <h2>

                        <a href="/organization/<%= organization.organization_id %>">

                            <%= organization.name %>

                        </a>

                    </h2>

                    <p class="organization-description">

                        <%= organization.description %>

                    </p>

                    <p class="organization-email">

                        <strong>Contact Email:</strong>

                        <%= organization.contact_email %>

                    </p>

                </div>

            </article>

        <% }) %>

    </section>

</main>

<% if (user && user.role_name === 'admin') { %>

    <p>
        <a href="/new-organization">
            Add a new organization
        </a>
    </p>

<% } %>

<%- include('partials/footer') %>