<%- include('partials/header') %>

<main>

 <h1>Dashboard</h1>

<p>Name: <%= name %></p>

<p>Email: <%= email %></p>

<% if (
    user &&
    user.role_name === 'admin'
) { %>

    <p>
        <a href="/users">
            View All Users
        </a>
    </p>

    <h2>
        Volunteer Activity
    </h2>

    <% if (
        volunteerActivity &&
        volunteerActivity.length > 0
    ) { %>

        <ul>

            <% volunteerActivity.forEach(activity => { %>

                <li>

                    <strong>
                        <%= activity.user_name %>
                    </strong>

                    volunteered for

                    <strong>
                        <%= activity.project_title %>
                    </strong>

                </li>

            <% }) %>

        </ul>

    <% } else { %>

        <p>
            No volunteer activity yet.
        </p>

    <% } %>

<% } %>

<h2>
    My Volunteer Projects
</h2>

<% if (
    volunteerProjects &&
    volunteerProjects.length > 0
) { %>

    <ul>

        <% volunteerProjects.forEach(project => { %>

            <li>

                <a href="/project/<%= project.project_id %>">
                    <%= project.title %>
                </a>

                <a
                    href="/project/<%= project.project_id %>/unvolunteer">
                    Remove
                </a>

            </li>

        <% }) %>

    </ul>

<% } else { %>

    <p>
        You are not volunteering for any projects.
    </p>

<% } %>

</main>

<%- include('partials/footer') %>
