<%- include('partials/header') %>

<main class="projects-page">

    <section class="projects-hero">

        <h1>Upcoming Service Projects</h1>

        <p>
            Explore upcoming volunteer opportunities and community
            improvement projects sponsored by our partner organizations.
        </p>

    </section>

    <section class="projects-grid">

        <% projects.forEach(project => { %>

            <article class="project-card">

                <h2>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </h2>

                <p class="project-sponsor">
                    Sponsored by:

                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </p>

                <p class="project-description">
                    <%= project.description %>
                </p>

                <p class="project-location">
                    📍 <strong><%= project.location %></strong>
                </p>

            </article>

        <% }) %>

    </section>

</main>

<%- include('partials/footer') %>