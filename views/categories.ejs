<%- include('partials/header') %>

<main class="categories-page">

    <section class="hero">

        <h2>Service Project Categories</h2>

        <p>
            Browse the different categories of service projects
            available through our community organizations.
        </p>

    </section>

    <section class="categories-container">

        <% categories.forEach(category => { %>

            <article class="category-card">

                <h3>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </h3>

                <p>
                    Explore projects related to
                    <strong><%= category.name %></strong>
                    and discover opportunities to serve
                    your community.
                </p>

            </article>

        <% }) %>

    </section>

    <p>
      <a href="/new-category">
        Add New Category
      </a>
    </p>

</main>

<%- include('partials/footer') %>